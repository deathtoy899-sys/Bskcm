getgenv().AutoFish = true 
getgenv().CatchDelay = 1.5 -- ปรับความช้าตอนดึงปลา (เพิ่มเลขนี้ถ้าต้องการให้ช้าลงอีก)

local FishLocation = Vector3.new(-1695.546, 83.277, -3367.889)

local Players = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local CaughRemote = ReplicatedStorage:WaitForChild("FishDev"):WaitForChild("Remote"):WaitForChild("CaughRemote")
local FishingRemote = ReplicatedStorage:WaitForChild("FishDev"):WaitForChild("Remote"):WaitForChild("FishingRemote")

local lastCastTime = 0

if getgenv().FastCatchConn then getgenv().FastCatchConn:Disconnect() end

getgenv().FastCatchConn = CaughRemote.OnClientEvent:Connect(function(waterType)
    if not getgenv().AutoFish then return end
    
    task.wait(getgenv().CatchDelay)
    
    pcall(function()
        CaughRemote:FireServer(true, waterType)
    end)
    
    local pGui = LocalPlayer:FindFirstChild("PlayerGui")
    local fGui = pGui and pGui:FindFirstChild("FishingGui")
    if fGui then
        local EndGame = fGui:FindFirstChild("EndGame")
        if EndGame then pcall(function() EndGame:Fire() end) end
        fGui.Enabled = false
        
        local GameScript = fGui:FindFirstChild("GameScript")
        if GameScript then GameScript.Enabled = false end
    end
end)

task.spawn(function()
    while task.wait(0.3) do
        if not getgenv().AutoFish then continue end

        local char = LocalPlayer.Character
        if not char then continue end
        local root = char:FindFirstChild("HumanoidRootPart")
        local hum = char:FindFirstChild("Humanoid")
        if not root or not hum or hum.Health <= 0 then continue end

        -- 1. เดินไปที่จุดตกปลาก่อน (ไม่โดนขัดโดย UI)
        local dist = (root.Position - FishLocation).Magnitude
        if dist > 5 then
            hum:MoveTo(FishLocation)
            continue
        end

        -- 2. เช็คเบ็ดและหยิบเบ็ดขึ้นมาถือ
        local rod = char:FindFirstChildWhichIsA("Tool")
        if not rod or not (rod.Name:find("เบ็ด") or rod.Name:find("Rod") or rod:FindFirstChild("Hook") or (rod:FindFirstChild("Handle") and rod.Handle:FindFirstChild("EndRod"))) then
            for _, item in ipairs(LocalPlayer.Backpack:GetChildren()) do
                if item:IsA("Tool") and (item.Name:find("เบ็ด") or item.Name:find("Rod") or item:FindFirstChild("Hook") or (item:FindFirstChild("Handle") and item.Handle:FindFirstChild("EndRod"))) then
                    hum:EquipTool(item)
                    task.wait(0.5)
                    rod = item
                    break
                end
            end
            continue
        end

        -- 3. เหวี่ยงเบ็ดตกปลา
        if rod and rod:FindFirstChild("Handle") and rod.Handle:FindFirstChild("EndRod") then
            local isFishing = false
            for _, v in pairs(rod:GetChildren()) do
                if v.Name == "Hook" then 
                    isFishing = true 
                    break
                end
            end

            if not isFishing and (tick() - lastCastTime > 3.0) then
                local targetCast = root.Position + (root.CFrame.LookVector * 20) - Vector3.new(0, 10, 0)
                
                pcall(function()
                    FishingRemote:FireServer(targetCast, rod.Handle.EndRod, rod)
                end)
                
                lastCastTime = tick()
                task.wait(1.5) 
            end
        end
    end
end)
